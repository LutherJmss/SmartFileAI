<Window x:Class="SmartFileAI.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartFileAI.UI.ViewModels"
        Title="SmartFile AI" Height="760" Width="1280" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="SmartFile AI" FontSize="18" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center" Margin="0,0,24,0" />
                <Grid Grid.Column="1" HorizontalAlignment="Left" Width="440">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="8,4">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}" /></TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="搜索" Command="{Binding SearchCommand}" Padding="14,6" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="开始扫描" Command="{Binding StartScanCommand}" Padding="12,6" Margin="0,0,8,0" />
                    <Button Content="终止扫描" Command="{Binding CancelScanCommand}" Padding="12,6" Margin="0,0,14,0" />
                    <Button Content="移至回收站" Command="{Binding DeleteSelectedFileCommand}" CommandParameter="Recycle" Padding="12,6" Margin="0,0,8,0" />
                    <Button Content="永久删除" Command="{Binding DeleteSelectedFileCommand}" CommandParameter="Permanent" Padding="12,6" Foreground="#B91C1C" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="300" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="#FAFAFA">
                <Border DockPanel.Dock="Top" Padding="10,8" Background="#E5E7EB"><TextBlock Text="计算机存储设备" FontWeight="Bold" /></Border>
                <TreeView ItemsSource="{Binding RootDrives}" SelectedItemChanged="TreeView_SelectedItemChanged" BorderThickness="0" Padding="4">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:DirectoryNodeViewModel}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2"><TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/><TextBlock Text="{Binding Name}"/></StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E5E7EB" />

            <DataGrid Grid.Column="2" ItemsSource="{Binding CurrentFiles}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      BorderThickness="0" RowHeight="28" SelectionMode="Single">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="移入回收站 (Delete)" Command="{Binding DeleteSelectedFileCommand}" CommandParameter="Recycle" />
                        <MenuItem Header="永久删除 (Shift+Delete)" Command="{Binding DeleteSelectedFileCommand}" CommandParameter="Permanent" Foreground="#B91C1C" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteSelectedFileCommand}" CommandParameter="Recycle" />
                    <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeleteSelectedFileCommand}" CommandParameter="Permanent" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="大小" Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" Width="100" />
                    <DataGridTextColumn Header="类型" Binding="{Binding Extension}" Width="80" />
                    <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" />
                    <DataGridTextColumn Header="完整路径" Binding="{Binding FullPath}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#E5E7EB" />
            <DockPanel Grid.Column="4" Background="#FAFAFA">
                <Border DockPanel.Dock="Top" Padding="10,8" Background="#E5E7EB"><TextBlock Text="文件属性详情" FontWeight="Bold" /></Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="文件名" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedFile.Name, FallbackValue='(未选中)'}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="完整路径" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedFile.FullPath, FallbackValue=-}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="容量大小" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedFile.Size, Converter={StaticResource FileSizeConverter}, FallbackValue=-}" Margin="0,0,0,12"/>
                        <TextBlock Text="文件类型" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedFile.Extension, FallbackValue=-}" Margin="0,0,0,12"/>
                        <TextBlock Text="修改时间" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedFile.ModifiedTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, FallbackValue=-}" Margin="0,0,0,12"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <Border Grid.Row="2" Background="#1F2937" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Foreground="#E5E7EB" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="文件: " Foreground="#9CA3AF"/><TextBlock Text="{Binding ScannedFileCount, StringFormat={}{0:N0}}" Foreground="#10B981" Margin="0,0,12,0"/>
                    <TextBlock Text="目录: " Foreground="#9CA3AF"/><TextBlock Text="{Binding ScannedDirCount, StringFormat={}{0:N0}}" Foreground="#60A5FA" Margin="0,0,12,0"/>
                    <TextBlock Text="容量: " Foreground="#9CA3AF"/><TextBlock Text="{Binding ScannedTotalBytes, Converter={StaticResource FileSizeConverter}}" Foreground="#F59E0B"/>
                </StackPanel>
                <ProgressBar Grid.Column="2" Width="120" Height="14" IsIndeterminate="{Binding IsScanning}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
